<!-- Page Header -->
<section class="py-12 lg:py-16 bg-white border-b border-gray-100">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl">Bible Study Information Card</h1>
  </div>
</section>

<!-- Bible Study Information Form -->
<section class="py-16 lg:py-24 bg-navy">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-2xl">
    <p class="text-white/80 mb-8 leading-relaxed">
      Please provide the information below and we'll be sure to reach out.
    </p>

    <form action="https://usebasin.com/f/4221c9a93bcd" method="POST" class="space-y-4">
      <input type="hidden" name="form" value="Bible Study Information Card">

      <!-- Name -->
      <div>
        <label for="bible-study-name" class="block text-xs uppercase tracking-widest text-white/70 mb-1">First and Last Name*</label>
        <input type="text" id="bible-study-name" name="name" required autocomplete="name" placeholder="enter your first and last name" class="w-full px-4 py-3 border border-white/30 bg-white text-navy placeholder-navy/40 focus:outline-none focus:border-spruce transition-colors">
      </div>

      <!-- Email -->
      <div>
        <label for="bible-study-email" class="block text-xs uppercase tracking-widest text-white/70 mb-1">Email*</label>
        <input type="email" id="bible-study-email" name="email" required autocomplete="email" placeholder="enter your email address" class="w-full px-4 py-3 border border-white/30 bg-white text-navy placeholder-navy/40 focus:outline-none focus:border-spruce transition-colors">
      </div>

      <!-- Phone -->
      <div>
        <label for="bible-study-phone" class="block text-xs uppercase tracking-widest text-white/70 mb-1">Phone</label>
        <input type="tel" id="bible-study-phone" name="phone" autocomplete="tel" placeholder="enter your phone number" class="w-full px-4 py-3 border border-white/30 bg-white text-navy placeholder-navy/40 focus:outline-none focus:border-spruce transition-colors">
      </div>

      <!-- Interests Checkboxes -->
      <div>
        <label class="block text-xs uppercase tracking-widest text-white/70 mb-3">I'm interested in (check all that apply):</label>
        <div class="bg-white/5 border border-white/20 px-4 py-4 space-y-3">
          <div class="flex items-start gap-3">
            <input type="checkbox" id="interest-general" name="interests[]" value="General Bible Study" class="mt-1 size-4 accent-spruce cursor-pointer">
            <label for="interest-general" class="text-white/90 cursor-pointer">General Bible Study</label>
          </div>
          <div class="flex items-start gap-3">
            <input type="checkbox" id="interest-mens" name="interests[]" value="Men's Bible Study" class="mt-1 size-4 accent-spruce cursor-pointer">
            <label for="interest-mens" class="text-white/90 cursor-pointer">Men's Bible Study</label>
          </div>
          <div class="flex items-start gap-3">
            <input type="checkbox" id="interest-womens" name="interests[]" value="Women's Bible Study" class="mt-1 size-4 accent-spruce cursor-pointer">
            <label for="interest-womens" class="text-white/90 cursor-pointer">Women's Bible Study</label>
          </div>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="text-center pt-4">
        <button type="submit" class="bg-spruce text-white px-10 py-3 uppercase tracking-widest text-sm hover:bg-spruce/90 transition-colors">
          Submit
        </button>
      </div>
    </form>
  </div>
</section>
